# Add only the variable names required by the selected project.
# Never put real API keys, passwords, or tokens in this file.

# Optional: set in the process environment; .env is not loaded automatically.
# Empty uses a random process-local key (fingerprints change on restart).
TRUSTREPLY_AUDIT_HMAC_KEY=
# Optional revision label; omitted/unknown unless explicitly configured.
TRUSTREPLY_BUILD_REVISION=
